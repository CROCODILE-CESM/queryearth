{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:queryearth:schema:rule:1",
  "title": "queryearth rule record or pack",
  "description": "A rule record is a GeoJSON Feature (RFC 7946) with the OGC JSON-FG 1.0 'time' member and queryearth properties. A pack file is a FeatureCollection of rule records with an optional collection header. Checks that JSON Schema cannot express are done by the loader (design section 5.3): codes unique in the Registry; a code's prefix, the part before the optional hyphen and the final digits, equal to a prefix the pack owns exactly (a pack owning CRU does not own CRUX001); no two packs claiming one prefix; 'periods' inside 'time'; dates valid in the proleptic Gregorian calendar, from year 1 to 9999; a box's south below its north; axis, facet, product and region names declared on the Registry.",
  "oneOf": [{"$ref": "#/$defs/rule"}, {"$ref": "#/$defs/pack"}],
  "$defs": {
    "code": {
      "description": "Namespace prefix plus 3-4 digits, as in ruff and pylint (CRU001, ERA5-014). A hyphen is optional after a prefix that ends in a letter and required after one that ends in a digit, so every code parses one way (Q8). The prefix QE is reserved for the built-in coverage rules.",
      "type": "string",
      "pattern": "^(?:[A-Z][A-Z0-9]{0,10}[A-Z]-?|[A-Z][A-Z0-9]{0,10}[0-9]-)[0-9]{3,4}$",
      "not": {"pattern": "^QE-?[0-9]{3,4}$"}
    },
    "slug": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "conformsTo": {
      "description": "JSON-FG conformance classes, on the root object only (a pack, or a rule stored as its own file). Writing it claims JSON-FG conformance, so it must list the core class.",
      "type": "array",
      "items": {"type": "string"},
      "contains": {"const": "http://www.opengis.net/spec/json-fg-1/1.0/conf/core"}
    },
    "crs84": {
      "description": "JSON-FG coordRefSys, on the root object only. queryearth accepts only CRS84 (longitude, latitude on WGS84), which is also the default when coordRefSys is absent. It never applies to geometry, which GeoJSON fixes to CRS84.",
      "const": "http://www.opengis.net/def/crs/OGC/0/CRS84"
    },
    "date": {
      "description": "Date at day precision in the proleptic Gregorian calendar, from year 1 to 9999. The loader rejects dates the pattern allows but the calendar lacks, such as 30 February.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "timestamp": {
      "description": "Civil date-time at second precision, UTC, written with a trailing Z.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "instant": {"oneOf": [{"$ref": "#/$defs/date"}, {"$ref": "#/$defs/timestamp"}]},
    "bound": {
      "description": "An interval end: an instant, or '..' for an open end.",
      "anyOf": [{"$ref": "#/$defs/instant"}, {"const": ".."}]
    },
    "interval": {
      "description": "Closed interval [start, end]; the end is inclusive at its stated precision ('2020-01-09' includes the whole day).",
      "type": "array",
      "prefixItems": [{"$ref": "#/$defs/bound"}, {"$ref": "#/$defs/bound"}],
      "minItems": 2,
      "maxItems": 2,
      "items": false
    },
    "time": {
      "description": "JSON-FG 1.0 time member, restricted in queryearth to exactly one of date, timestamp or interval (JSON-FG also allows consistent combinations). JSON-FG reads null or absent as no temporal information; queryearth reads it as always.",
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "properties": {
            "date": {"$ref": "#/$defs/date"},
            "timestamp": {"$ref": "#/$defs/timestamp"},
            "interval": {"$ref": "#/$defs/interval"}
          },
          "additionalProperties": false,
          "minProperties": 1,
          "maxProperties": 1
        }
      ]
    },
    "position": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"type": "number"}},
    "linearRing": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/position"}},
    "polygon": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": {"const": "Polygon"},
        "coordinates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/linearRing"}},
        "bbox": {"type": "array", "minItems": 4, "items": {"type": "number"}}
      }
    },
    "multiPolygon": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": {"const": "MultiPolygon"},
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/linearRing"}}
        },
        "bbox": {"type": "array", "minItems": 4, "items": {"type": "number"}}
      }
    },
    "geometry": {
      "description": "null means the rule is not spatially constrained (global), unless properties.box or properties.region_ref gives the area.",
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/polygon"}, {"$ref": "#/$defs/multiPolygon"}]
    },
    "box": {
      "description": "Longitude arc plus latitude limits. width 360 is a latitude band. The arc may cross the antimeridian (west 170, width 20 covers 170E to 170W).",
      "type": "object",
      "required": ["west", "width", "south", "north"],
      "properties": {
        "west": {"type": "number", "minimum": -180, "exclusiveMaximum": 180},
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 360},
        "south": {"type": "number", "minimum": -90, "maximum": 90},
        "north": {"type": "number", "minimum": -90, "maximum": 90}
      },
      "additionalProperties": false
    },
    "regionRef": {
      "description": "namespace:id of a named region registered on the Registry (for example ar6:WSAF). Unresolved references are a load error.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*:[A-Za-z0-9_.+-]+$"
    },
    "axisRange": {
      "description": "Interval on a declared ordered axis, in the axis unit. Omitted bounds are open.",
      "type": "object",
      "properties": {
        "gt": {"type": "number"},
        "ge": {"type": "number"},
        "lt": {"type": "number"},
        "le": {"type": "number"},
        "unit": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false,
      "anyOf": [
        {"required": ["gt"]},
        {"required": ["ge"]},
        {"required": ["lt"]},
        {"required": ["le"]}
      ],
      "not": {"anyOf": [{"required": ["gt", "ge"]}, {"required": ["lt", "le"]}]}
    },
    "pattern": {
      "description": "Facet value or glob pattern (fnmatch, case-sensitive after product-alias resolution).",
      "type": "string",
      "minLength": 1
    },
    "facetMatch": {
      "oneOf": [
        {
          "description": "Shorthand for any_of.",
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/pattern"}
        },
        {
          "type": "object",
          "properties": {
            "any_of": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pattern"}},
            "none_of": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pattern"}}
          },
          "additionalProperties": false,
          "minProperties": 1
        }
      ]
    },
    "versionRange": {
      "description": "OSV-style: introduced is inclusive, fixed is exclusive, last_affected is inclusive. Ranges compare dotted integers; versions lists exact strings for anything else (ERA5T, ERA5.1).",
      "type": "object",
      "properties": {
        "introduced": {"type": "string", "minLength": 1},
        "fixed": {"type": "string", "minLength": 1},
        "last_affected": {"type": "string", "minLength": 1},
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false,
      "minProperties": 1,
      "not": {"required": ["fixed", "last_affected"]}
    },
    "facets": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/slug"},
      "properties": {
        "version": {
          "oneOf": [
            {"$ref": "#/$defs/versionRange"},
            {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/versionRange"}}
          ]
        }
      },
      "additionalProperties": {"$ref": "#/$defs/facetMatch"}
    },
    "suggestion": {
      "description": "A domain-agnostic action. The engine never interprets target or key; consumers do.",
      "type": "object",
      "required": ["target", "key", "value"],
      "properties": {
        "target": {"type": "string", "minLength": 1},
        "key": {"type": "string", "minLength": 1},
        "value": true,
        "rationale": {"type": "string"}
      },
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "properties": {
        "type": {"enum": ["documentation", "article", "dataset", "code", "report", "web"]},
        "citation": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "doi": {"type": "string", "pattern": "^10\\.[0-9]{4,9}/\\S+$"},
        "retrieved": {"$ref": "#/$defs/date"}
      },
      "additionalProperties": false,
      "anyOf": [{"required": ["citation"]}, {"required": ["url"]}, {"required": ["doi"]}]
    },
    "evidence": {
      "description": "ISO 19157-style evidence: how the statement was established (method), what was measured, and the result.",
      "type": "object",
      "required": ["method"],
      "properties": {
        "method": {"enum": ["documented", "derived", "measured", "expert"]},
        "measure": {"type": "string"},
        "result": true,
        "script": {"type": "string"},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "properties": {
      "type": "object",
      "required": ["code", "kind", "title", "message"],
      "if": {"required": ["status"], "properties": {"status": {"const": "reviewed"}}},
      "then": {"required": ["references"], "properties": {"references": {"minItems": 1}}},
      "properties": {
        "code": {"$ref": "#/$defs/code"},
        "kind": {"enum": ["warning", "suggestion"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "message": {"type": "string", "minLength": 1},
        "instruction": {"type": "string"},
        "level": {
          "description": "A logging level. When omitted, warning for a warning and info for a suggestion.",
          "enum": ["info", "warning", "error"]
        },
        "confidence": {"enum": ["observed", "likely", "possible", "unknown"]},
        "action": {"enum": ["can_be_used", "use_with_caution", "do_not_use", "replaced"]},
        "facets": {"$ref": "#/$defs/facets"},
        "axes": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/slug"},
          "additionalProperties": {"$ref": "#/$defs/axisRange"}
        },
        "dimensions": {
          "description": "Values for plugin dimensions declared on the Registry, keyed by dimension name. Each value is validated at load against that dimension's own schema.",
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/slug"},
          "minProperties": 1
        },
        "region_ref": {
          "oneOf": [
            {"$ref": "#/$defs/regionRef"},
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/regionRef"}
            }
          ]
        },
        "box": {"$ref": "#/$defs/box"},
        "periods": {
          "description": "Union of closed intervals that refines the top-level time member; each must lie inside it.",
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/interval"}
        },
        "recurrence": {
          "type": "object",
          "required": ["months"],
          "properties": {
            "months": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "uniqueItems": true,
              "items": {"type": "integer", "minimum": 1, "maximum": 12}
            }
          },
          "additionalProperties": false
        },
        "time_start": {"$ref": "#/$defs/bound"},
        "time_end": {"$ref": "#/$defs/bound"},
        "min_overlap": {"type": "number", "minimum": 0, "maximum": 1},
        "suggestions": {"type": "array", "items": {"$ref": "#/$defs/suggestion"}},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "references": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
        "status": {"enum": ["draft", "reviewed", "deprecated"]},
        "created": {"$ref": "#/$defs/timestamp"},
        "updated": {"$ref": "#/$defs/timestamp"},
        "withdrawn": {"$ref": "#/$defs/timestamp"},
        "supersedes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/code"}},
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "patternProperties": {"^x_[a-z0-9_]+$": true},
      "additionalProperties": false,
      "not": {"required": ["box", "region_ref"]},
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "suggestion"}}},
          "then": {"required": ["suggestions"], "properties": {"suggestions": {"minItems": 1}}}
        }
      ]
    },
    "rule": {
      "type": "object",
      "required": ["type", "geometry", "properties"],
      "properties": {
        "type": {"const": "Feature"},
        "id": {"type": ["string", "number"]},
        "geometry": {"$ref": "#/$defs/geometry"},
        "time": {"$ref": "#/$defs/time"},
        "place": {"type": "null"},
        "bbox": {"type": "array", "minItems": 4, "items": {"type": "number"}},
        "properties": {"$ref": "#/$defs/properties"},
        "featureType": {"type": "string"},
        "coordRefSys": {"$ref": "#/$defs/crs84"},
        "conformsTo": {"$ref": "#/$defs/conformsTo"}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "description": "box and region_ref replace the geometry, so geometry must then be null.",
          "if": {
            "properties": {
              "properties": {"anyOf": [{"required": ["box"]}, {"required": ["region_ref"]}]}
            }
          },
          "then": {"properties": {"geometry": {"type": "null"}}}
        },
        {
          "description": "time_start/time_end are a fallback for editors that drop the JSON-FG time member; they may not be combined with a non-null time member.",
          "if": {
            "properties": {
              "properties": {
                "anyOf": [{"required": ["time_start"]}, {"required": ["time_end"]}]
              }
            }
          },
          "then": {
            "anyOf": [
              {"not": {"required": ["time"]}},
              {"properties": {"time": {"type": "null"}}}
            ]
          }
        },
        {
          "description": "periods refine the time member, so a record with periods must carry a non-null time member.",
          "if": {"properties": {"properties": {"required": ["periods"]}}},
          "then": {"required": ["time"], "properties": {"time": {"type": "object"}}}
        }
      ]
    },
    "pack": {
      "type": "object",
      "required": ["type", "features"],
      "properties": {
        "type": {"const": "FeatureCollection"},
        "conformsTo": {"$ref": "#/$defs/conformsTo"},
        "coordRefSys": {"$ref": "#/$defs/crs84"},
        "metadata": {
          "description": "Collection header (after ED-318). Required when the file is loaded without a pack.toml; must agree with pack.toml otherwise.",
          "type": "object",
          "required": ["pack", "version", "code_prefix"],
          "properties": {
            "pack": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
            "version": {"type": "string", "minLength": 1},
            "code_prefix": {
              "description": "The code prefix or prefixes this pack owns. Every code in the pack starts with one of them, and two loaded packs may not claim the same prefix. QE is reserved for built-in rules.",
              "oneOf": [
                {"type": "string", "pattern": "^[A-Z][A-Z0-9]{1,11}$"},
                {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{1,11}$"}
                }
              ]
            },
            "title": {"type": "string"},
            "description": {"type": "string"},
            "license": {"type": "string"},
            "issued": {"$ref": "#/$defs/timestamp"},
            "technical_limitations": {"type": "array", "items": {"type": "string"}},
            "references": {"type": "array", "items": {"$ref": "#/$defs/reference"}}
          },
          "patternProperties": {"^x_[a-z0-9_]+$": true},
          "additionalProperties": false
        },
        "bbox": {"type": "array", "minItems": 4, "items": {"type": "number"}},
        "features": {
          "description": "JSON-FG allows conformsTo and coordRefSys only on the root object, so features inside a pack carry neither.",
          "type": "array",
          "items": {
            "allOf": [
              {"$ref": "#/$defs/rule"},
              {"not": {"anyOf": [{"required": ["conformsTo"]}, {"required": ["coordRefSys"]}]}}
            ]
          }
        }
      },
      "additionalProperties": false
    }
  }
}
